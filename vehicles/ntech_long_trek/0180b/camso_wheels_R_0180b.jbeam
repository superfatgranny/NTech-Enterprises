	//debug outputs
	
	// "Tyre Aspect Coef"[ReartireAspectRatioDebug not found]

    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.430000}, //Radius of the tire nodes
    {"hubRadius":0.241300}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.320000}, //Width of the rim
    {"tireWidth":0.320000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=1577496.500000 * ($rimStiffnessMult_R or 1)", "hubTreadBeamDamp":"$=76.901131 * ($rimStiffnessMult_R or 1)"},
    {"hubPeripheryBeamSpring":"$=2422700.000000 * ($rimStiffnessMult_R or 1)", "hubPeripheryBeamDamp":"$=95.301201 * ($rimStiffnessMult_R or 1)"},
    {"hubSideBeamSpring":"$=1345009.500000 * ($rimStiffnessMult_R or 1)", "hubSideBeamDamp":"$=37.792252 * ($rimStiffnessMult_R or 1)"},
    {"hubNodeWeight":1.499537},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=1232186.375000 * ($tireStiffnessMult_R or 1)","wheelSideBeamDampExpansion":"$=77.264420 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_R or 1) * $rearPSI","wheelSideBeamDamp":"$=77.264420 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideTransitionZone":0.111172,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=256536.921875 * ($tireStiffnessMult_R or 1)","wheelTreadBeamDamp":"$=105.763924 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=208650.031250 * ($tireStiffnessMult_R or 1)","wheelTreadReinfBeamDamp":"$=143.074783 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=202787.390625 * ($tireStiffnessMult_R or 1)","wheelPeripheryBeamDamp":"$=141.050400 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=189268.234375 * ($tireStiffnessMult_R or 1)","wheelPeripheryReinfBeamDamp":"$=136.267639 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=29922.917969 * ($tireStiffnessMult_R or 1)","wheelReinfBeamDamp":"$=385.294952 * ($tireStiffnessMult_R or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.484488},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$rearPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *1.05"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.600000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":1.700000},
    {"stribeckVelMult":1.700000},

    //advanced friction values
    {"noLoadCoef":1.071313}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000079*0.9"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.090419}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.100000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":161625.078125, "hubBeamStrength":183136.328125},

    {"wheelSideBeamDeform":58138.515625,"wheelSideBeamStrength":72673.148438},
    {"wheelReinfBeamDeform":290692.593750,"wheelReinfBeamStrength":290692.593750},
    {"wheelTreadBeamDeform":29069.257812,"wheelTreadBeamStrength":37790.035156},
    {"wheelTreadReinfBeamDeform":29069.257812,"wheelTreadReinfBeamStrength":37790.035156},
    {"wheelPeripheryBeamDeform":145346.296875,"wheelPeripheryBeamStrength":145346.296875},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
    {"brakeType":false},
