			//["shaft", "frontDriveShaft", "transferCase", 1],
			["shaft", "rearDriveShaft", "transferCase", 2, {"canDisconnect":true,"uiName":"Front Output Shaft"}]
		],
		"frontMotor": {
			"torque":[
				["rpm", "torque"],
				[0, "$=1770.80$mod$"],
				[267, "$=1770.80$mod$"],
				[468, "$=1770.80$mod$"],
				[1002, "$=1770.80$mod$"],
				[1537, "$=1770.80$mod$"],
