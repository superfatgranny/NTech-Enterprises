	//debug outputs
	
	// "Tyre Aspect Coef"[FronttireAspectRatioDebug not found]
	
    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.430000}, //Radius of the tire nodes
    {"hubRadius":0.241300}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.275000}, //Width of the rim
    {"tireWidth":0.275000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=1430569.500000 * ($rimStiffnessMult_F or 1)", "hubTreadBeamDamp":"$=69.316147 * ($rimStiffnessMult_F or 1)"},
    {"hubPeripheryBeamSpring":"$=2168480.750000 * ($rimStiffnessMult_F or 1)", "hubPeripheryBeamDamp":"$=85.340996 * ($rimStiffnessMult_F or 1)"},
    {"hubSideBeamSpring":"$=1812938.250000 * ($rimStiffnessMult_F or 1)", "hubSideBeamDamp":"$=50.950397 * ($rimStiffnessMult_F or 1)"},
    {"hubNodeWeight":1.343445},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=1124091.125000 * ($tireStiffnessMult_F or 1)","wheelSideBeamDampExpansion":"$=70.486298 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_F or 1) * $frontPSI","wheelSideBeamDamp":"$=70.486298 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideTransitionZone":0.104633,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=229077.171875 * ($tireStiffnessMult_F or 1)","wheelTreadBeamDamp":"$=95.458824 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=186316.109375 * ($tireStiffnessMult_F or 1)","wheelTreadReinfBeamDamp":"$=129.134308 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=183664.906250 * ($tireStiffnessMult_F or 1)","wheelPeripheryBeamDamp":"$=128.212250 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=171420.578125 * ($tireStiffnessMult_F or 1)","wheelPeripheryReinfBeamDamp":"$=123.864799 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=25692.251953 * ($tireStiffnessMult_F or 1)","wheelReinfBeamDamp":"$=341.000488 * ($tireStiffnessMult_F or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.441985},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$frontPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *0.98"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.600000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":1.700000},
    {"stribeckVelMult":1.700000},

    //advanced friction values
    {"noLoadCoef":1.071313}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000115 * 1"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.090419}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.100000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":147446.296875, "hubBeamStrength":167070.453125},

    {"wheelSideBeamDeform":53038.238281,"wheelSideBeamStrength":66297.796875},
    {"wheelReinfBeamDeform":265191.187500,"wheelReinfBeamStrength":265191.187500},
    {"wheelTreadBeamDeform":26519.119141,"wheelTreadBeamStrength":34474.855469},
    {"wheelTreadReinfBeamDeform":26519.119141,"wheelTreadReinfBeamStrength":34474.855469},
    {"wheelPeripheryBeamDeform":132595.593750,"wheelPeripheryBeamStrength":132595.593750},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
    {"brakeType":false},
    {"rotorMaterial":false},
    {"brakeVentingCoef":false}
    ]
