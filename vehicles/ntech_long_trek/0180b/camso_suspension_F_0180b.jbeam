{
"Camso_strut_F_0180b": {
    "information":{
        "authors":"BeamNG",
        "name":"Diesel MacPherson Strut Front Suspension",
        "value":150
    },
    "variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$RideHeightOffsetFront", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Ride Height Offset", "Front suspension ride height offset", {"stepDis":0.001,"subCategory":"Springs"}],
	    ["$trackOffset_F", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Wheel Offset", "Spacing of front wheels", {"stepDis":0.001,"subCategory":"Spacing"}],	
        ["$brakeOffset_F", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Brake Offset", "Visual front brake offset", {"stepDis":0.001,"subCategory":"Spacing"}],
        ["$hubStiffnessMult_F", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Front Hub Stiffness", "Lower this value if wheels break off. Raise it if there is unwanted flex in the hubs", {"subCategory":"Wheel Hubs","stepDis":1,"minDis":10,"maxDis":300}]
    ],
    "slotType" : "Camso_suspension_F",
    "slots": [
        ["type", "default", "description"],
        //["wheels_front","wheels_front","Front Wheels", {"nodeOffset":{"x":"$=$frontSuspensionOffsetX or 0", "y":"$=$frontSuspensionOffsetY or 0", "z":"$=$frontSuspensionOffsetZ or 0"}}],
        ["camso_hubs_front_0180b","camso_hubs_front_0180b","Front Hubs"],
        ["Camso_suspensionmesh_F","Camso_suspensionmesh_F_0180b","Suspension Mesh", {"nodeOffset":{"x":"$=$frontSuspensionOffsetX or 0", "y":"$=$frontSuspensionOffsetY or 0", "z":"$=$frontSuspensionOffsetZ or 0"}}],
        ["Camso_brake_F","Camso_brake_F_0180b", "Front Brakes", {"nodeOffset":{"x":"$=($frontSuspensionOffsetX or 0)+($brakeOffset_F or 0)", "y":"$=$frontSuspensionOffsetY or 0", "z":"$=$frontSuspensionOffsetZ or 0"}}],
        ["Camso_wheeldata_F_strut","Camso_wheeldata_F_strut_0180b", "Front Spindles"{"coreSlot":true}],
        ["Camso_coilover_F_strut","Camso_coilover_F_strut_0180b", "Front Coilovers"],
        ["Camso_swaybar_F_strut","Camso_swaybar_F_strut_0180b", "Front Sway Bar"],
        ["Camso_steering_strut","Camso_steering_strut_0180b", "Steering", ],
        ["Camso_differential_front", "Camso_differential_front_0180b", "Front Differential"]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":13.237103},
        {"group":["hub_F", "susp_F"]},
        //hub mounting points for lower wishbone, strut rail bottom point
        ["fh1r", -0.727014, -0.014658, -0.146575],
        ["fh1l",  0.727014, -0.014658, -0.146575],
		
		{"nodeWeight":9.164148},

        //strut body slidenode
        ["fh2r", -0.643760, 0.014658, 0.146575],
        ["fh2l",  0.643760, 0.014658, 0.146575],

        //tie rod end
        ["fh3r", -0.674247, 0.187617, -0.134849],
        ["fh3l",  0.674247, 0.187617, -0.134849],

        //brake caliper
        //{"nodeWeight":12.218864},
        ["fh5r", -0.738741, -0.164165, 0.000000],
        ["fh5l",  0.738741, -0.164165, 0.000000],
		
		//swaybar bushes (these should be approx same width and height as lower ball joint, 150mm behind)		
		
		["fsb1r", -0.727014,  0.278493, -0.146575], 
        ["fsb1l",  0.727014,  0.278493, -0.146575],

        //subframe
        {"selfCollision":false},
        {"nodeWeight":12.772470},
        {"group":["subframe_F", "susp_F"]},
        {"chemEnergy":526.982727,"burnRate":0.406476,"flashPoint":"$=($ignitionTemperatureMod or 1)*794.603455",
            "specHeat":0.8,"smokePoint":"$=($ignitionTemperatureMod or 1)*520.952576",/*"selfIgnitionCoef":"$=($ignitionChanceMod or 1)*0.010000"*/},
        ["fx1r", -0.340055, -0.234521, -0.128986],
        ["fx1l",  0.340055, -0.234521, -0.128986],
        ["fx2r", -0.340055,  0.234521, -0.105534],
        ["fx2l",  0.340055,  0.234521, -0.105534],

        {"nodeWeight":14.369028},
        //strut rail top point
        ["fs1r", -0.551124, 0.049836, 0.492494],
        ["fs1l",  0.551124, 0.049836, 0.492494],

        {"group":""},
        ["fco1r", -0.680110, -0.014658, 0.410411],
        ["fco1l",  0.680110, -0.014658, 0.410411],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        {"group":""}
    ],
	
	
	

    "rails": {
        //rails form a line between 2 nodes that slidenodes will slide on. Used for any kind of telescoping motion such as steering racks, hydraulic rams, strut shafts.
        //strut shaft rail
        "strut_FR":{
            "links:":["fh1r", "fs1r"], "broken:":[], "looped":false, "capped":true
        },
        "strut_FL":{
            "links:":["fh1l", "fs1l"], "broken:":[], "looped":false, "capped":true
        }
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        //attach strut body to strut shaft rail
        ["fh2r", "strut_FR", true, true, 0.0, 32585674.000000, "FLT_MAX", "FLT_MAX"],
        ["fh2l", "strut_FL", true, true, 0.0, 32585674.000000, "FLT_MAX", "FLT_MAX"]
    ],
    "beams": [
        ["id1:", "id2:"],
        //macpherson strut suspension
        {"beamPrecompression":1, "beamType":"|NORMAL"},
		{"highlight":{"radius":0.0075, "col":"#ff0137d9"}},
        //hub
        {"beamSpring":"$=14664673.000000*($hubStiffnessMult_F or 1)","beamDamp":"$=509.119324*($hubStiffnessMult_F or 1)"},
        {"beamDeform":103860.343750,"beamStrength":572250.125000},
        ["fh1r","fh2r"],
        ["fh1l","fh2l"],
        ["fh1r","fh3r"],
        ["fh1l","fh3l"],
        ["fh2r","fh3r"],
        ["fh2l","fh3l"],
        ["fh1r","fh5r"],
        ["fh1l","fh5l"],
        ["fh2r","fh5r"],
        ["fh2l","fh5l"],
        ["fh3r","fh5r"],
        ["fh3l","fh5l"],
		{"highlight":{"radius":0.0, "col":"#ff0137d9"}},

        //hub to wheel axle nodes
		{"highlight":{"radius":0.0075, "col":"#ff2264d9"}},
        //breakGroup: when one beam breaks, all beams in the group are forced to break
        //{"beamSpring":"$=8147946.000000*$hubStiffnessMult_F","beamDamp":305.471588},
        //{"beamDeform":103860.343750,"beamStrength":511155.812500},
        {"breakGroup":"wheel_FR"},
        //optional: tells the physics engine not to worry if it can't find the nodes (ie, user chose to remove the wheels)
        {"optional":true},
        ["fh1r","fw1r"],
        ["fh2r","fw1r"{"name":"axle_FR"}],
        ["fh3r","fw1r"],
        ["fh5r","fw1r"],
        ["fh1r","fw1rr"],
        ["fh2r","fw1rr"],
        ["fh3r","fw1rr"],
        ["fh5r","fw1rr"],
        {"breakGroup":"wheel_FL"},
        ["fh1l","fw1l"{"name":"axle_FL"}],
        ["fh2l","fw1l"],
        ["fh3l","fw1l"],
        ["fh5l","fw1l"],
        ["fh1l","fw1ll"],
        ["fh2l","fw1ll"],
        ["fh3l","fw1ll"],
        ["fh5l","fw1ll"],
        {"optional":false},
        {"breakGroup":""},
		{"highlight":{"radius":0.00, "col":"#ff2264d9"}},

        //lower wishbone
		{"highlight":{"radius":0.0075, "col":"#FFFF005f"}},
        {"beamSpring":10049469.000000,"beamDamp":2679.500977},
        //{"beamDeform":103860.343750,"beamStrength":572250.125000},
        //dampCutoffHz raises the damping stability by filtering out high frequencies
        ["fx2r","fh1r",{"dampCutoffHz":500}],
        ["fx1r","fh1r",{"dampCutoffHz":500}],
        ["fx2l","fh1l",{"dampCutoffHz":500}],
        ["fx1l","fh1l",{"dampCutoffHz":500}],
		{"highlight":{"radius":0.000, "col":"#FFFF005f"}},
		
		
		


        //subframe
        {"beamSpring":11975787.000000,"beamDamp":399.139679},
        ["fx1l", "fx2l"],
        ["fx1r", "fx2r"],
        ["fx1l", "fx1r"],
        ["fx2l", "fx2r"],
        ["fx1l", "fx2r"],
        ["fx2l", "fx1r"],
		
		
		//swaybar Supports
		
		{"highlight":{"radius":0.01, "col":"#7c1919d9"}},
		
		["fx1r", "fsb1r"],
		["fx2r", "fsb1r"],		
		["a54", "fsb1r"],
		["fco1r", "fsb1r"],
		
		
		["fx1l", "fsb1l"],
		["fx2l", "fsb1l"],		
		["a53", "fsb1l"],	
		["fco1l", "fsb1l"],		
		
		{"highlight":{"radius":0.02, "col":"#ff37ffd9"}},
		
		//debug swaybar viz
			
		{"beamSpring":1.000000,"beamDamp":1},
		
			
		["fh1l", "fsb1l"],
		["fh1r", "fsb1r"],
		["fsb1r", "fsb1l"],
		
		{"highlight":{"radius":0.0, "col":"#ff37ffd9"}},

        //subframe to body
        {"highlight":{"radius":0.0075, "col":"#FFFF005f"}}
        //Primary Beams
        {"beamSpring":7984390.000000,"beamDamp":399.139679},
        ["fx2l", "a21"],
        ["fx2r", "a22"],
        ["fx2l", "a22"],
        ["fx2r", "a21"],

        ["fx2l", "a53"],
        ["fx2r", "a54"],
        ["fx2l", "a54"],
        ["fx2r", "a53"],

        ["fx2l", "a17"],
        ["fx2r", "a18"],
        ["fx2l", "a18"],
        ["fx2r", "a17"],
		
		
		

        //Secondary Beams
        {"beamSpring":6387831.500000,"beamDamp":399.139679},
        {"highlight":{"radius":0.0075, "col":"#FF00FF5f"}}
        ["fx1l", "a25"],
        ["fx1r", "a26"],
        ["fx1l", "a26"],
        ["fx1r", "a25"],

        ["fx1l", "a57"],
        ["fx1r", "a58"],
        ["fx1l", "a58"],
        ["fx1r", "a57"],
         {"highlight":{"radius":0.0075, "col":"#00000000"}}

        //shock tower
        //{"highlight":{"radius":0.0075, "col":"#FF00005f"}}
        {"beamSpring":5589552.000000,"beamDamp":399.139679},
        ["fs1l", "fx1l"],
        ["fs1l", "fx2l"],
        ["fs1r", "fx1r"],
        ["fs1r", "fx2r"],

        {"highlight":{"radius":0.0075, "col":"#FF00005f"}}
        ["fs1l", "a53"],
        ["fs1l", "a57"],
        ["fs1r", "a54"],
        ["fs1r", "a58"],
        {"highlight":{"radius":0.0075, "col":"#00000000"}}
        ["fco1l", "fx1l"],
        ["fco1l", "fx2l"],
        ["fco1r", "fx1r"],
        ["fco1r", "fx2r"],

        {"highlight":{"radius":0.0075, "col":"#FF00005f"}}
        ["fco1l", "a53"],
        ["fco1l", "a57"],
        ["fco1r", "a54"],
        ["fco1r", "a58"],
        {"highlight":{"radius":0.0075, "col":"#00000000"}}

        ["fco1r", "fs1r"],
        ["fco1l", "fs1l"],

        {"beamSpring":11177507.000000,"beamDamp":399.139679},
        ["fs1r", "fs1l"],
        ["fco1r", "fco1l"],
        //{"highlight":{"radius":0.0, "col":"#00000000"}}

        //wheel intrusion limiter
        //limiters prevent suspension inverting in crashes
        {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":1},
        {"beamSpring":1598155.250000,"beamDamp":399.139679,"beamDeform":263432.187500,"beamStrength":1436902.875000},
        {"beamPrecompression":0.6},
        ["fw1ll","fx1r"],
        ["fw1ll","fx2r"],
        ["fw1rr","fx1l"],
        ["fw1rr","fx2l"],
        ["fw1ll","fs1r"],
        ["fw1rr","fs1l"],
        {"beamPrecompression":1},

        //wishbone inversion limiter
        {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":3},
        {"beamSpring":1598155.250000,"beamDamp":399.139679,"beamDeform":263432.187500,"beamStrength":1436902.875000},
        {"beamPrecompression":0.77},
        ["fx2l","fh2l"],
        ["fx1l","fh2l"],
        ["fx2r","fh2r"],
        ["fx1r","fh2r"],
        {"beamPrecompression":0.725},
        ["fs1r","fh1r"],
        ["fs1l","fh1l"],
        {"beamSpring":false,"beamDamp":false,"beamDeform":false,"beamStrength":false},
        {"beamLimitSpring":false,"beamLimitDamp":false},
        {"beamPrecompression":1},
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ],
     "triangles": [
        ["id1:", "id2:", "id3:"],
        {"groundModel":"metal"},
        {"dragCoef":0},
        ["fx2l", "fx1l", "fx1r"],
        ["fx1r", "fx2r", "fx2l"],
        ["fx1r", "fh1r", "fx2r"],
