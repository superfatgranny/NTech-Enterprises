		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$springRate_F", "range", "N/m", "Suspension", 50000.000000, 1000, 300000, "Front Spring Rate", "Front suspension spring rate", {"stepDis":10,"subCategory":"Springs"}],
		["$dampRate_bump_F", "range", "N/m/s", "Suspension", 3420.000000, 500, 60000, "Front Damper Bump Rate", "Front suspension bump rate", {"stepDis":10,"subCategory":"Dampers"}],
		["$dampRate_bump_fast_F", "range", "N/m/s", "Suspension", 2223.000000, 500, 60000, "Front Damper Fast Bump Rate", "Front suspension fast bump rate", {"stepDis":10,"subCategory":"Dampers"}],
		["$dampRate_rebound_F", "range", "N/m/s", "Suspension", 7524.000000, 500, 60000, "Front Damper Rebound Rate", "Front suspension rebound rate", {"stepDis":10,"subCategory":"Dampers"}]
		["$dampRate_rebound_fast_F", "range", "N/m/s", "Suspension", 3385.800049, 500, 60000, "Front Damper Fast Rebound Rate", "Front suspension fast rebound rate", {"stepDis":10,"subCategory":"Dampers"}]
    ],
    "beams": [
        ["id1:", "id2:"],
        //springs
		
		
        //beamPrecompression here changes the ride height
        {"beamPrecompression":1.0, "beamType":"|NORMAL"},
        {"beamLongBound":0.0, "beamShortBound":0.0},
		{"beamLimitSpring":50000.000000, "beamLimitDamp":0},
        //beamSpring here controls spring rate (N/m)
        {"beamSpring":"$springRate_F","beamDamp":0},
        {"beamDeform":103860.343750,"beamStrength":511155.812500},
        ["fh2r","fco1r"{"precompressionRange":"$=0.141816+$RideHeightOffsetFront", "name":"spring_FR",
            "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":15,"volumeFactor":1.1,"decayFactor":5,"pitchFactor":0.2,"maxStress":2800}],
        ["fh2l","fco1l"{"precompressionRange":"$=0.141816+$RideHeightOffsetFront", "name":"spring_FL",
            "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":15,"volumeFactor":1.1,"decayFactor":5,"pitchFactor":0.2,"maxStress":2800}],

        //dampers
		
		
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        //damper values set here (N/m/s)
        {"beamSpring":0,"beamDamp":"$dampRate_bump_F"},
        ["fh1l","fco1l", {"name":"damper_FL", "beamDampRebound":"$dampRate_rebound_F","beamDampVelocitySplit":0.15,"beamDampFast":"$dampRate_bump_fast_F","beamDampReboundFast":"$dampRate_rebound_fast_F","dampCutoffHz":500}],
        ["fh1r","fco1r", {"name":"damper_FR", "beamDampRebound":"$dampRate_rebound_F","beamDampVelocitySplit":0.15,"beamDampFast":"$dampRate_bump_fast_F","beamDampReboundFast":"$dampRate_rebound_fast_F","dampCutoffHz":500}],
		
			

        //suspension travel limits
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":0,"beamDamp":0},
        {"beamLimitSpring":511155.812500,"beamLimitDamp":8145.909180},
        //the Range values determine the start of the limit in meters from spawn length (not the precompressed length)
        //basically this is where the bumpstops are first contacted
        //the boundZone value determines the transition distance where spring and damp values approach limit values after reaching the Range
        //the spring and damp move towards limit values after passing the Range distance. At Range + boundZone, the spring and damp arrive at limit values.
        //basically this is how long/progressive the bumpstop is
        //these special values supersede over shortBound and longBound, make sure to only use this value inline with beams
        ["fh1r","fs1r",{"longBoundRange":0.107560,"shortBoundRange":0.107560,"boundZone":0.040756,"dampCutoffHz":250}],
        ["fh1l","fs1l",{"longBoundRange":0.107560,"shortBoundRange":0.107560,"boundZone":0.040756,"dampCutoffHz":250}],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":false,"beamDamp":false},
		{"beamLimitSpring":false,"beamLimitDamp":false}
    ]
},
