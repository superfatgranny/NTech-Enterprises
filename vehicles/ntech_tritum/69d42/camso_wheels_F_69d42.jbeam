	//debug outputs
	
	// "Tyre Aspect Coef"[FronttireAspectRatioDebug not found]
	
    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.275000}, //Radius of the tire nodes
    {"hubRadius":0.228600}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.205000}, //Width of the rim
    {"tireWidth":0.205000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=414150.500000 * ($rimStiffnessMult_F or 1)", "hubTreadBeamDamp":"$=19.868790 * ($rimStiffnessMult_F or 1)"},
    {"hubPeripheryBeamSpring":"$=614101.000000 * ($rimStiffnessMult_F or 1)", "hubPeripheryBeamDamp":"$=24.194254 * ($rimStiffnessMult_F or 1)"},
    {"hubSideBeamSpring":"$=625243.187500 * ($rimStiffnessMult_F or 1)", "hubSideBeamDamp":"$=17.368128 * ($rimStiffnessMult_F or 1)"},
    {"hubNodeWeight":0.381281},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=206495.187500 * ($tireStiffnessMult_F or 1)","wheelSideBeamDampExpansion":"$=14.530600 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_F or 1) * $frontPSI","wheelSideBeamDamp":"$=14.530600 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideTransitionZone":0.163056,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=95457.656250 * ($tireStiffnessMult_F or 1)","wheelTreadBeamDamp":"$=29.638432 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=77638.898438 * ($tireStiffnessMult_F or 1)","wheelTreadReinfBeamDamp":"$=40.094128 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=30647.287109 * ($tireStiffnessMult_F or 1)","wheelPeripheryBeamDamp":"$=25.190517 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=28604.134766 * ($tireStiffnessMult_F or 1)","wheelPeripheryReinfBeamDamp":"$=24.336353 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=9262.356445 * ($tireStiffnessMult_F or 1)","wheelReinfBeamDamp":"$=98.478012 * ($tireStiffnessMult_F or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.102249},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$frontPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *0.98"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.500000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":2.160000},
    {"stribeckVelMult":1.900000},

    //advanced friction values
    {"noLoadCoef":1.273718}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000184 * 1"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.097765}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.100000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":34110.113281, "hubBeamStrength":38649.949219},

    {"wheelSideBeamDeform":12269.825195,"wheelSideBeamStrength":15337.281250},
    {"wheelReinfBeamDeform":61349.125000,"wheelReinfBeamStrength":61349.125000},
    {"wheelTreadBeamDeform":6134.912598,"wheelTreadBeamStrength":7975.386230},
    {"wheelTreadReinfBeamDeform":6134.912598,"wheelTreadReinfBeamStrength":7975.386230},
    {"wheelPeripheryBeamDeform":30674.562500,"wheelPeripheryBeamStrength":30674.562500},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
    {"brakeType":false},
    {"rotorMaterial":false},
    {"brakeVentingCoef":false}
    ]
}, 
