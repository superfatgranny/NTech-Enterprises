"Camso_coilover_R_doublewishbone_99933": {
    "information":{
        "authors":"BeamNG",
        "name":"Sputter Active Progressive Rear Coilovers",
        "value":200
    },
    "slotType" : "Camso_coilover_R_doublewishbone",
    	"controller": [
        ["fileName"],
        ["camso_activeDampers" {"name":"adaptiveRearDamper", "dampBeamNames":["damper_RR", "damper_RL"], "otherUpdate": true}]
    ],
    "adaptiveRearDamper": {
        "modes": [
            ["name",    "beamDampCoefMin", "beamDampCoefMax", "beamDampFastCoefMin", "beamDampFastCoefMax", "beamDampReboundCoefMin", "beamDampReboundCoefMax", "beamDampReboundFastCoefMin", "beamDampReboundFastCoefMax", "beamDampVelocitySplitCoefMin", "beamDampVelocitySplitCoefMax", "gMin", 	"gMax"],
            ["soft",	0.5,  				1,    		    	0.5,              	  1,  	                 0.5,						1,						0.5,							1,								1.1,						1,								5,				10],
            ["hard",    0.8,               	1,                  0.8,                  1,                  	 0.8,						1,						0.8,							1,								1,							1,								3,				6]
        ]
    },
    "beams": [
        ["id1:", "id2:"],
        //rear springs
        //beamPrecompression here changes the ride height
        {"beamPrecompression":1.0, "beamType":"|BOUNDED"},
        {"beamLongBound":0.0, "beamShortBound":0.0},
		{"beamLimitSpring":27000.000000, "beamLimitDamp":0},
        //beamSpring here controls spring rate (N/m)
        {"beamSpring":18000.000000,"beamDamp":0},
        {"beamDeform":35116.273438,"beamStrength":172827.156250},
        ["rh3r","rs1r"{"precompressionRange":"$=0.100977+$RideHeightOffsetRear", "name":"spring_RR",
            "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":15,"volumeFactor":1.1,"decayFactor":5,"pitchFactor":0.2,"maxStress":2800}],
        ["rh3l","rs1l"{"precompressionRange":"$=0.100977+$RideHeightOffsetRear", "name":"spring_RL",
            "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":15,"volumeFactor":1.1,"decayFactor":5,"pitchFactor":0.2,"maxStress":2800}],

        //dampers
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        //damper values set here (N/m/s)
        {"beamSpring":0,"beamDamp":1080.000000},
        ["rh3l","rs1l",{"name":"damper_RL", "beamDampRebound":2376.000000,"beamDampVelocitySplit":0.15,"beamDampFast":702.000000,"beamDampReboundFast":1069.199951,"dampCutoffHz":500}],
        ["rh3r","rs1r",{"name":"damper_RR", "beamDampRebound":2376.000000,"beamDampVelocitySplit":0.15,"beamDampFast":702.000000,"beamDampReboundFast":1069.199951,"dampCutoffHz":500}],

        //hard bump stop
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":0,"beamDamp":0},
        {"beamLimitSpring":172827.156250,"beamLimitDamp":2754.217529},
        //the Range values determine the start of the limit in meters from spawn length (not the precompressed length)
        //basically this is where the bumpstops are first contacted
        //the boundZone value determines the transition distance where spring and damp values approach limit values after reaching the Range
        //the spring and damp move towards limit values after passing the Range distance. At Range + boundZone, the spring and damp arrive at limit values.
        //basically this is how long/progressive the bumpstop is
        //these special values supersede over shortBound and longBound, make sure to only use this value inline with beams
        ["rh3l","rs1l",{"longBoundRange":0.100000,"shortBoundRange":0.100000,"boundZone":0.040410,"dampCutoffHz":250}],
        ["rh3r","rs1r",{"longBoundRange":0.100000,"shortBoundRange":0.100000,"boundZone":0.040410,"dampCutoffHz":250}],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":false,"beamDamp":false},
		{"beamLimitSpring":false,"beamLimitDamp":false}
    ]
},
