	//debug outputs
	
	// "Tyre Aspect Coef"[ReartireAspectRatioDebug not found]

    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.322500}, //Radius of the tire nodes
    {"hubRadius":0.279400}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.195000}, //Width of the rim
    {"tireWidth":0.195000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=571300.625000 * ($rimStiffnessMult_R or 1)", "hubTreadBeamDamp":"$=27.144199 * ($rimStiffnessMult_R or 1)"},
    {"hubPeripheryBeamSpring":"$=827919.062500 * ($rimStiffnessMult_R or 1)", "hubPeripheryBeamDamp":"$=32.676735 * ($rimStiffnessMult_R or 1)"},
    {"hubSideBeamSpring":"$=615647.562500 * ($rimStiffnessMult_R or 1)", "hubSideBeamDamp":"$=17.183109 * ($rimStiffnessMult_R or 1)"},
    {"hubNodeWeight":0.515881},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=223290.468750 * ($tireStiffnessMult_R or 1)","wheelSideBeamDampExpansion":"$=16.246094 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_R or 1) * $rearPSI","wheelSideBeamDamp":"$=16.246094 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideTransitionZone":0.164614,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=124094.117188 * ($tireStiffnessMult_R or 1)","wheelTreadBeamDamp":"$=36.333790 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=100929.882812 * ($tireStiffnessMult_R or 1)","wheelTreadReinfBeamDamp":"$=49.151443 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=35526.687500 * ($tireStiffnessMult_R or 1)","wheelPeripheryBeamDamp":"$=29.161089 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=33158.242188 * ($tireStiffnessMult_R or 1)","wheelPeripheryReinfBeamDamp":"$=28.172289 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=10809.875000 * ($tireStiffnessMult_R or 1)","wheelReinfBeamDamp":"$=114.386345 * ($tireStiffnessMult_R or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.118203},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$rearPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *1.05"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.500000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":2.295000},
    {"stribeckVelMult":2.250000},

    //advanced friction values
    {"noLoadCoef":1.451533}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000216*0.9"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.122865}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.600000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":39432.449219, "hubBeamStrength":44680.656250},

    {"wheelSideBeamDeform":14184.334961,"wheelSideBeamStrength":17730.417969},
    {"wheelReinfBeamDeform":70921.671875,"wheelReinfBeamStrength":70921.671875},
    {"wheelTreadBeamDeform":7092.167480,"wheelTreadBeamStrength":9219.817383},
    {"wheelTreadReinfBeamDeform":7092.167480,"wheelTreadReinfBeamStrength":9219.817383},
    {"wheelPeripheryBeamDeform":35460.835938,"wheelPeripheryBeamStrength":35460.835938},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
